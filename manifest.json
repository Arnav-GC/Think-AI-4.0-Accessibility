{
  "manifest_version": 3,
  "name": "OmniAccess AI",
  "version": "1.0.0",
  "description": "AI-powered accessibility assistant with voice control, image descriptions, text simplification, WCAG auditing, and live captions",

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "action": {
    "default_title": "OmniAccess AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel/index.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "css": [
        "content/fonts.css",
        "content/overlay.css"
      ],
      "js": [
        "content/wcag-auditor.js",
        "content/live-captions.js",
        "content/switch-access.js",
        "content/read-aloud.js",
        "content/image-describer.js",
        "content/text-simplifier.js",
        "content/voice-nav.js",
        "content/gaze-tracker.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "content/*",
        "shared/*",
        "sidepanel/*",
        "website.html",
        "website-demo.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://generativelanguage.googleapis.com https://api.x.ai;"
  }
}
